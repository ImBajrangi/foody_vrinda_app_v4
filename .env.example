# ==============================================================================
# Foody Vrinda - Environment Variables Template
# Copy this file to:
#   .env.development (for local Alpha/Dev environment)
#   .env.staging     (for Beta/Staging environment)
#   .env.production  (for Production environment - configure in Vercel/CI secrets)
# DO NOT COMMIT REAL SECRETS OR SERVICE ROLE KEYS TO GIT.
# ==============================================================================

# Supabase Project Credentials (Use separate project for each environment)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-environment-anon-key

# Administrative & Developer Access Allowlist (Comma-separated lowercase emails)
VITE_DEVELOPER_EMAILS=developer@foodyvrinda.com
VITE_ADMIN_EMAILS=admin@foodyvrinda.com
